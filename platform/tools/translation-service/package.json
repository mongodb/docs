{
  "name": "@mongodb-docs/translation-service",
  "version": "0.1.0",
  "private": true,
  "description": "In-house translation service for Docs Platform (v1: stateless, synchronous, flat JSON platform strings).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "pnpm build && node --env-file-if-exists=.env scripts/e2e-translate.mjs"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.5",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  }
}
