{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "applications": {
    "landing": {
      "development": {
        "fallback": "landing-rho-topaz.vercel.app"
      }
    },
    "atlas": {
      "routing": [
        {
          "paths": ["/docs/atlas", "/docs/atlas/:path*"]
        }
      ]
    },
    "manual": {
      "routing": [
        {
          "paths": [
            "/docs/manual",
            "/docs/manual/:path*",
            "/docs/upcoming",
            "/docs/upcoming/:path*",
            "/docs/v8.3",
            "/docs/v8.3/:path*",
            "/docs/v8.0",
            "/docs/v8.0/:path*",
            "/docs/v7.0",
            "/docs/v7.0/:path*",
            "/docs/docs_static_manual/:path*"
          ]
        }
      ]
    }
  }
}