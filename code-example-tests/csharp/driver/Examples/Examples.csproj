<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="DotNetEnv" Version="3.1.1" />
      <!-- Local RAG examples use Ollama through Microsoft.Extensions.AI, as the
           tutorial documents. Floating version: pin this to the exact preview
           that exposes OllamaEmbeddingGenerator/OllamaChatClient once resolved. -->
      <PackageReference Include="Microsoft.Extensions.AI.Ollama" Version="9.*-*" />
      <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
      <PackageReference Include="MongoDB.Driver.Encryption" Version="3.13.0" />
      <PackageReference Include="MongoDB.EntityFrameworkCore" Version="10.0.1" />
      <!-- OpenTelemetry tracing examples. The in-memory exporter lets the tests
           capture and assert the spans the driver emits. The hosting packages
           support the generic host example. -->
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
      <PackageReference Include="OpenTelemetry" Version="1.19.1" />
      <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.19.1" />
      <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
      <PackageReference Include="SharpCompress" Version="0.49.1" />
      <PackageReference Include="Snappier" Version="1.3.1" />
    </ItemGroup>

</Project>
