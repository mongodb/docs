use sample_mflix
db.moviesWithAutomatedEmbeddings.aggregate([
  {
    "$vectorSearch": {
      "index": "autoEmbeddingIndex",
      "path": "fullplot",
      "query": {
        "text": "time travel"
      },
      "numCandidates": 100,
      "limit": 10
    }
  },
  {
    "$project": {
      "_id": 0,
      "fullplot": 1,
      "title": 1,
    }
  }
])