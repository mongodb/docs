# REQUIRED for the openai and anthropic backends — Grove AI Gateway API key.
# One key covers both backends; the endpoint picks the wire format.
# Leave this blank if you set GROVE_API_KEY below. A non-blank value here
# always wins, so a leftover placeholder would silently select the AI Gateway.
AI_GATEWAY_API_KEY=

# Alternative: the legacy Azure Grove gateway, for environments that cannot
# reach the corp-only AI Gateway (for example GitHub Actions runners). Set
# GROVE_API_KEY INSTEAD of AI_GATEWAY_API_KEY — when both are set, the AI
# Gateway wins. GROVE_API_KEY also switches the Anthropic auth header to
# `api-key`.
# GROVE_API_KEY=your-legacy-grove-key-here

# OPTIONAL overrides (defaults shown). The endpoint follows whichever key
# you set; override only to point somewhere else.
# OPENAI_ENDPOINT=https://ai-gateway.corp.mongodb.com/openai/v1/responses
# OPENAI_ENDPOINT=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1/responses
# OPENAI_MODEL=gpt-5.5
# OPENAI_TIMEOUT_MS=30000

# OPTIONAL overrides (defaults shown). The endpoint follows whichever key
# you set; override only to point somewhere else.
# ANTHROPIC_ENDPOINT=https://ai-gateway.corp.mongodb.com/anthropic/v1/messages
# ANTHROPIC_ENDPOINT=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/anthropic/v1/messages
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_TIMEOUT_MS=120000
# ANTHROPIC_MAX_TOKENS=16000

# AWS Translate backend (only needed for `pnpm e2e --backend aws-translate`).
# Credentials come from the AWS SDK default chain, e.g. an SSO profile
# (`aws sso login --profile <name>`) OR
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
# The identity needs the translate:TranslateText permission.
# AWS_PROFILE=your-profile-name

# OPTIONAL overrides (defaults shown)
# AWS_TRANSLATE_REGION=us-east-1
# AWS_TRANSLATE_TIMEOUT_MS=30000
# AWS_TRANSLATE_CONCURRENCY=5

# Optional: AWS custom terminology applied to every TranslateText request
# by the aws-translate backend. Create/update it with `pnpm sync-terminology`.
# Set only when translating into the terminology's target language; AWS
# behavior for a terminology that does not cover the request's language
# pair is undocumented.
# AWS_TRANSLATE_TERMINOLOGY_NAME=aws-translate-glossary
