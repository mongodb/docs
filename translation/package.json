{
  "name": "@mongodb-docs/translation-service",
  "version": "0.1.0",
  "private": true,
  "description": "In-house translation service for Docs Platform (v1: stateless, synchronous, flat JSON platform strings).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "npm run build && node --env-file-if-exists=.env scripts/e2e-translate.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.5.4"
  }
}
