{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "applications": {
    "landing": {
      "development": {
        "fallback": "mongodb-docs.vercel.app"
      }
    },
    "manual": {
      "routing": [
        {
          "paths": [
            "/docs/upcoming",
            "/docs/upcoming/:path*",
            "/docs/manual",
            "/docs/manual/:path*",
            "/docs/v8.3",
            "/docs/v8.3/:path*",
            "/docs/v8.0",
            "/docs/v8.0/:path*",
            "/docs/v7.0",
            "/docs/v7.0/:path*",
            "/docs/docs_static_manual/:path*"
          ]
        }
      ]
    },
    "atlas": {
      "routing": [
        {
          "paths": [
            "/docs/atlas",
            "/docs/atlas/:path((?!government).*)"
          ]
        }
      ]
    },
    "atlas-government": {
      "routing": [
        {
          "paths": [
            "/docs/atlas/government",
            "/docs/atlas/government/:path*"
          ]
        }
      ]
    }
  }
}
