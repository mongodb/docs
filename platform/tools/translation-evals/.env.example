# Translation Evals — environment variables

# --- Translation + judge (Grove gateway) ---
# Required: used by the translator backend and the judge.
GROVE_API_KEY=
# Optional: overrides the translation service default model.
GROVE_MODEL=
# Optional: overrides the Grove endpoint.
GROVE_ENDPOINT=
# Optional: request timeout in ms (default 30000).
GROVE_TIMEOUT_MS=
# Required for the judge; MUST differ from the translator model (avoids
# self-preference bias).
JUDGE_MODEL=

# --- Braintrust ---
# The `braintrust` CLI does NOT load this file. Put BRAINTRUST_API_KEY in a
# file named `.env.braintrust`, or export it in your shell before running
# `pnpm eval`. The CLI reads BRAINTRUST_API_KEY from the environment or from
# `.env.braintrust` only.
BRAINTRUST_API_KEY=
# Optional: Braintrust project name (default: docs-translations-rendered).
BRAINTRUST_PROJECT=

# --- Tool behavior ---
# Optional: comma-separated target locales (default: pt-br,es,ko-kr,ja-jp,zh-cn).
TARGET_LOCALES=
# Optional: path to a JSON file of non-translatable terms, e.g. {"terms":["MongoDB","Atlas"]}.
TERMS_FILE=
