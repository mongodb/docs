{
    "name": "mongodb/docs-laravel-mongodb-examples-upcoming",
    "description": "Tested Laravel MongoDB code examples for the upcoming documentation version",
    "type": "project",
    "require": {
        "php": "^8.2",
        "mongodb/laravel-mongodb": "5.x-dev"
    },
    "require-dev": {
        "orchestra/testbench": "^10|^11",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "MongoDB\\Laravel\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
