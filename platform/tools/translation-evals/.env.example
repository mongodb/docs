# Translation Evals — environment variables

# --- Translation + judge (Grove AI Gateway) ---
# Required: used by the translator backend and the judge.
AI_GATEWAY_API_KEY=
# Optional: translator model. Its family selects the backend:
# a `claude-*` model uses the Anthropic Messages path, anything else the
# OpenAI Responses path. Defaults to the service's `gpt-5.5`.
TRANSLATOR_MODEL=
# Optional: explicit translator backend, overriding the model-family heuristic.
# One of: openai, anthropic, aws-translate, stub.
TRANSLATOR_BACKEND=

# --- AWS Translate backend (only when TRANSLATOR_BACKEND=aws-translate) ---
# Credentials come from the AWS SDK default provider chain: an SSO profile
# (`aws sso login --profile <name>`) or
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN.
# The identity needs the translate:TranslateText permission.
# See translation-service/README.md for the SSO setup steps.
# AWS_PROFILE=your-profile-name

# OPTIONAL overrides (defaults shown)
# AWS_TRANSLATE_REGION=us-east-1
# AWS_TRANSLATE_TIMEOUT_MS=30000
# AWS_TRANSLATE_CONCURRENCY=5

# Required for the judge; MUST differ from the translator model (avoids
# self-preference bias). Its family selects the wire format, like the
# translator: a `claude-*` value uses the Anthropic Messages path, anything
# else the OpenAI Responses path.
JUDGE_MODEL=
# Per-family endpoint and timeout overrides are read by the translation
# service directly, not by this tool:
#   OPENAI_ENDPOINT / OPENAI_TIMEOUT_MS       (default 30000)
#   ANTHROPIC_ENDPOINT / ANTHROPIC_TIMEOUT_MS (default 120000)

# --- Braintrust ---
# Read by the `braintrust` CLI, which does NOT load a plain `.env` on its own.
# The `eval` stage passes this process's environment to the CLI, so setting it
# here is enough for `pnpm eval`. A `.env.braintrust` file also works.
BRAINTRUST_API_KEY=
# Optional: Braintrust project name (default: docs-translations).
BRAINTRUST_PROJECT=
# Optional: overrides the Braintrust experiment name. When unset, the name is
# built from the project, locales, run id, and models, for example
# "atlas es 2026-10-23-a1b2c3 [gpt-5.5 -> claude-sonnet-4-5]".
EVAL_EXPERIMENT_NAME=

# --- Tool behavior ---
# Optional: comma-separated target locales (default: pt-br,es,ko-kr,ja-jp,zh-cn).
TARGET_LOCALES=
# Optional: path to a JSON file of non-translatable terms, e.g. {"terms":["MongoDB","Atlas"]}.
TERMS_FILE=
