{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "node ../scripts/install-deps.mjs",
  "buildCommand": "cd .. && pnpm exec turbo run build:deploy --filter=docs-site --env-mode=loose",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**": false,
      "*vercel*": true,
      "**/*vercel*": true
    }
  }
}
