cmake_minimum_required(VERSION 3.15)

project(cpp_qe)

if(NOT DEFINED CMAKE_CXX_STANDARD)
    set(CMAKE_CXX_STANDARD 17)
endif()

set(CMAKE_CXX_EXTENSIONS OFF)

find_package(mongocxx REQUIRED)
find_package(bsoncxx REQUIRED)

add_executable(queryable_encryption_tutorial
    queryable_encryption_tutorial.cpp
)

target_link_libraries(queryable_encryption_tutorial PRIVATE mongo::mongocxx_shared mongo::bsoncxx_shared)
