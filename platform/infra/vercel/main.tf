locals {
  # microfrontends.json, generated by docs-site/scripts/generate-microfrontends.ts,
  # is the single list of apps: adding an app there creates its Vercel project,
  # env vars, and group membership, and removing one destroys them.
  microfrontends = jsondecode(file("${path.module}/../../docs-site/microfrontends.json"))
  apps           = local.microfrontends.applications

  default_apps = [for name, app in local.apps : name if try(app.routing, null) == null]
  # Not one(): it errors before the group's precondition can report the count.
  default_app_name = try(local.default_apps[0], "")
  member_apps      = { for name, app in local.apps : name => app if name != local.default_app_name }

  # The default app's local-development fallback doubles as its stable domain,
  # so the generator keeps the two from drifting.
  default_app_domain = try(local.apps[local.default_app_name].development.fallback, "")

  # Team shared environment variables, keyed by name, with the exact targets
  # they have in the Vercel dashboard. Values are managed in the dashboard;
  # Terraform only links each one to every project.
  shared_env_vars = {
    NPM_AWS_KEY    = ["production", "preview"]
    NPM_AWS_SECRET = ["production", "preview"]
  }

  shared_env_links = {
    for pair in setproduct(keys(local.shared_env_vars), keys(local.apps)) :
    "${pair[0]}/${pair[1]}" => { key = pair[0], app = pair[1] }
  }
}

resource "vercel_project" "app" {
  for_each = local.apps

  name           = each.key
  framework      = "nextjs"
  root_directory = "platform/docs-site"
  node_version   = "24.x"
  git_repository = {
    type = "github"
    repo = var.git_repo
  }

  vercel_authentication = {
    deployment_type = "standard_protection_new"
  }
}

resource "vercel_project_domain" "default_app" {
  project_id = vercel_project.app[local.default_app_name].id
  domain     = local.default_app_domain

  lifecycle {
    precondition {
      condition     = local.default_app_domain != ""
      error_message = "The default app in microfrontends.json must set development.fallback; that domain is assigned to its Vercel project."
    }
  }
}

resource "vercel_project_environment_variable" "docs_project" {
  for_each = local.apps

  project_id = vercel_project.app[each.key].id
  key        = "DOCS_PROJECT"
  value      = each.key
  target     = ["production", "preview", "development"]
  sensitive  = false
}

data "vercel_shared_environment_variable" "shared" {
  for_each = local.shared_env_vars

  key    = each.key
  target = each.value
}

resource "vercel_shared_environment_variable_project_link" "app" {
  for_each = local.shared_env_links

  shared_environment_variable_id = data.vercel_shared_environment_variable.shared[each.value.key].id
  project_id                     = vercel_project.app[each.value.app].id
}

resource "vercel_microfrontend_group" "docs" {
  name = var.group_name
  default_app = {
    project_id = vercel_project.app[local.default_app_name].id
  }

  lifecycle {
    precondition {
      condition     = length(local.default_apps) == 1
      error_message = "microfrontends.json must have exactly one app without routing (the default app); found ${length(local.default_apps)}."
    }
  }
}

resource "vercel_microfrontend_group_membership" "app" {
  for_each = local.member_apps

  project_id             = vercel_project.app[each.key].id
  microfrontend_group_id = vercel_microfrontend_group.docs.id
}
