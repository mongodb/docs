# @langchain/community lists @browserbasehq/stagehand as an optional peer
# dependency, and stagehand pins older peer ranges (dotenv@^16, openai@^4)
# that conflict with the versions this suite uses. We don't use stagehand,
# so accept the resolution the lockfile already encodes. This makes a fresh
# `npm install` in CI match local installs.
legacy-peer-deps=true
