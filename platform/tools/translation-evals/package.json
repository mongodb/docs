{
  "name": "translation-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "resolve": "tsx --env-file-if-exists=.env src/cli.ts resolve",
    "scrape-prod": "tsx --env-file-if-exists=.env src/cli.ts scrape-prod",
    "translate": "tsx --env-file-if-exists=.env src/cli.ts translate",
    "serve": "tsx --env-file-if-exists=.env src/cli.ts serve",
    "scrape-local": "tsx --env-file-if-exists=.env src/cli.ts scrape-local",
    "dataset": "tsx --env-file-if-exists=.env src/cli.ts dataset",
    "eval": "tsx --env-file-if-exists=.env src/cli.ts eval",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --cache",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@mongodb-docs/translation-service": "workspace:*",
    "franc": "^6.2.0",
    "playwright": "^1.44.0",
    "translation-mdx-adapter": "workspace:*"
  },
  "devDependencies": {
    "@platform/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "braintrust": "^3.0.0",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "^1.0.0"
  }
}
