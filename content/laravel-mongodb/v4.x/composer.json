{
    "name": "mongodb/docs-laravel-mongodb-examples-v4",
    "description": "Tested Laravel MongoDB code examples for the v4.x documentation version",
    "type": "project",
    "require": {
        "php": "^8.1",
        "mongodb/laravel-mongodb": "^4.9"
    },
    "require-dev": {
        "mongodb/builder": "^0.2",
        "orchestra/testbench": "^8|^9",
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "MongoDB\\Laravel\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
